k/cyber-essentials.php</w:t></w:r></w:hyperlink><w:r><w:rPr><w:rStyle w:val="apple-converted-space"/><w:color w:val="000000"/></w:rPr><w:t> </w:t></w:r><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>— this is the one page on the current site that reflects the design direction and colour palette we want across the whole redesign (deep navy</w:t></w:r><w:r><w:rPr><w:rStyle w:val="apple-converted-space"/><w:color w:val="000000"/></w:rPr><w:t> </w:t></w:r><w:r><w:rPr><w:rStyle w:val="HTMLCode"/><w:color w:val="000000"/></w:rPr><w:t>#0a1628</w:t></w:r><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>, teal</w:t></w:r><w:r><w:rPr><w:rStyle w:val="apple-converted-space"/><w:color w:val="000000"/></w:rPr><w:t> </w:t></w:r><w:r><w:rPr><w:rStyle w:val="HTMLCode"/><w:color w:val="000000"/></w:rPr><w:t>#00c9a7</w:t></w:r><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>, amber accent</w:t></w:r><w:r><w:rPr><w:rStyle w:val="apple-converted-space"/><w:color w:val="000000"/></w:rPr><w:t> </w:t></w:r><w:r><w:rPr><w:rStyle w:val="HTMLCode"/><w:color w:val="000000"/></w:rPr><w:t>#f0b742</w:t></w:r><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>, Fraunces serif + DM Sans typography)</w:t></w:r></w:p><w:p w14:paraId="1973CFD7" w14:textId="77777777" w:rsidR="007B157D" w:rsidRDefault="007B157D" w:rsidP="007B157D"><w:pPr><w:pStyle w:val="font-claude-response-body"/><w:rPr><w:color w:val="000000"/></w:rPr></w:pPr><w:r><w:rPr><w:rStyle w:val="Strong"/><w:color w:val="000000"/></w:rPr><w:t>2) Reference websites / preferred design style</w:t></w:r></w:p><w:p w14:paraId="0AF91DFC" w14:textId="77777777" w:rsidR="007B157D" w:rsidRDefault="007B157D" w:rsidP="007B157D"><w:pPr><w:pStyle w:val="font-claude-response-body"/><w:rPr><w:color w:val="000000"/></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>The visual direction is inspired by:</w:t></w:r></w:p><w:p w14:paraId="12000CD7" w14:textId="77777777" w:rsidR="007B157D" w:rsidRDefault="007B157D" w:rsidP="007B157D"><w:pPr><w:pStyle w:val="font-claude-response-body"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:rPr><w:color w:val="000000"/></w:rPr></w:pPr><w:hyperlink r:id="rId8" w:history="1"><w:r><w:rPr><w:rStyle w:val="Hyperlink"/><w:b/><w:bCs/></w:rPr><w:t>https://amtivo.com/uk/</w:t></w:r></w:hyperlink><w:r><w:rPr><w:rStyle w:val="apple-converted-space"/><w:color w:val="000000"/></w:rPr><w:t> </w:t></w:r><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>— for the clean, white-dominant, corporate feel and typography rhythm</w:t></w:r></w:p><w:p w14:paraId="26F941BD" w14:textId="77777777" w:rsidR="007B157D" w:rsidRDefault="007B157D" w:rsidP="007B157D"><w:pPr><w:pStyle w:val="font-claude-response-body"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:rPr><w:color w:val="000000"/></w:rPr></w:pPr><w:hyperlink r:id="rId9" w:history="1"><w:r><w:rPr><w:rStyle w:val="Hyperlink"/><w:b/><w:bCs/></w:rPr><w:t>https://www.qmsuk.com/</w:t></w:r></w:hyperlink><w:r><w:rPr><w:rStyle w:val="apple-converted-space"/><w:color w:val="000000"/></w:rPr><w:t> </w:t></w:r><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>— for the prominent phone-in-header, trust signals above the fold, and conversion-focused CTA placement</w:t></w:r></w:p><w:p w14:paraId="435BBAE3" w14:textId="77777777" w:rsidR="007B157D" w:rsidRDefault="007B157D" w:rsidP="007B157D"><w:pPr><w:pStyle w:val="font-claude-response-body"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:rPr><w:color w:val="000000"/></w:rPr></w:pPr><w:hyperlink r:id="rId10" w:history="1"><w:r><w:rPr><w:rStyle w:val="Hyperlink"/><w:b/><w:bCs/></w:rPr><w:t>https://www.glocertinternational.com/</w:t></w:r></w:hyperlink><w:r><w:rPr><w:rStyle w:val="apple-converted-space"/><w:color w:val="000000"/></w:rPr><w:t> </w:t></w:r><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>— for the breadth of certification and cyber security services organisation</w:t></w:r></w:p><w:p w14:paraId="311D7E64" w14:textId="77777777" w:rsidR="007B157D" w:rsidRDefault="007B157D" w:rsidP="007B157D"><w:pPr><w:pStyle w:val="font-claude-response-body"/><w:rPr><w:color w:val="000000"/></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>The design language on our own cyber-</w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>essentials.php</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> page is the target aesthetic — please replicate that treatment (typography, colour, section rhythm, animation) across all page templates. We want elegant and professional, not templated or generic. No stock hero images, no clip-art icons.</w:t></w:r></w:p><w:p w14:paraId="538699B2" w14:textId="77777777" w:rsidR="007B157D" w:rsidRDefault="007B157D" w:rsidP="007B157D"><w:pPr><w:pStyle w:val="font-claude-response-body"/><w:rPr><w:color w:val="000000"/></w:rPr></w:pPr><w:r><w:rPr><w:rStyle w:val="Strong"/><w:color w:val="000000"/></w:rPr><w:t>3) Content and design status of the 80 pages</w:t></w:r></w:p><w:p w14:paraId="6DC3138F" w14:textId="77777777" w:rsidR="007B157D" w:rsidRDefault="007B157D" w:rsidP="007B157D"><w:pPr><w:pStyle w:val="font-claude-response-body"/><w:rPr><w:color w:val="000000"/></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>A mix of both:</w:t></w:r></w:p><w:p w14:paraId="6FD2433E" w14:textId="77777777" w:rsidR="007B157D" w:rsidRDefault="007B157D" w:rsidP="007B157D"><w:pPr><w:pStyle w:val="font-claude-response-body"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numPr><w:rPr><w:color w:val="000000"/></w:rPr></w:pPr><w:r><w:rPr><w:rStyle w:val="Strong"/><w:color w:val="000000"/></w:rPr><w:t>Existing content that needs to be redesigned and rewritten</w:t></w:r><w:r><w:rPr><w:rStyle w:val="apple-converted-space"/><w:color w:val="000000"/></w:rPr><w:t> </w:t></w:r><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>— around 55 pages, including all current ISO certification pages, training pages, inspection pages, About, Why Choose Us, Services, Contact, etc.</w:t></w:r></w:p><w:p w14:paraId="706A89BF" w14:textId="77777777" w:rsidR="007B157D" w:rsidRDefault="007B157D" w:rsidP="007B157D"><w:pPr><w:pStyle w:val="font-claude-response-body"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numPr><w:rPr><w:color w:val="000000"/></w:rPr></w:pPr><w:r><w:rPr><w:rStyle w:val="Strong"/><w:color w:val="000000"/></w:rPr><w:t>Brand-new pages</w:t></w:r><w:r><w:rPr><w:rStyle w:val="apple-converted-space"/><w:color w:val="000000"/></w:rPr><w:t> </w:t></w:r><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>— around 25 pages, including new ISO standards (ISO 27701, 27017, 27018, 55001, 14064, 45003), new service lines (SOC 2, PCI DSS, GDPR Assessment, Penetration Testing, ESG &amp; Sustainability), industry vertical pages (9 sectors), and utility pages (Certificate Verification, Accreditations, etc.)</w:t></w:r></w:p><w:p w14:paraId="423357B4" w14:textId="77777777" w:rsidR="007B157D" w:rsidRDefault="007B157D" w:rsidP="007B157D"><w:pPr><w:pStyle w:val="font-claude-response-body"/><w:rPr><w:color w:val="000000"/></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:lastRenderedPageBreak/><w:t>I'll share a</w:t></w:r><w:r><w:rPr><w:rStyle w:val="apple-converted-space"/><w:color w:val="000000"/></w:rPr><w:t> </w:t></w:r><w:r><w:rPr><w:rStyle w:val="Strong"/><w:color w:val="000000"/></w:rPr><w:t>detailed 81-page category-by-category development plan</w:t></w:r><w:r><w:rPr><w:rStyle w:val="apple-converted-space"/><w:color w:val="000000"/></w:rPr><w:t> </w:t></w:r><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>(attached:</w:t></w:r><w:r><w:rPr><w:rStyle w:val="apple-converted-space"/><w:color w:val="000000"/></w:rPr><w:t> </w:t></w:r><w:r><w:rPr><w:rStyle w:val="HTMLCode"/><w:color w:val="000000"/></w:rPr><w:t>TRAIBCERT_Pages_81.docx</w:t></w:r><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>) which lists every single page, its status (REDESIGN or NEW), and the category structure.</w:t></w:r><w:r><w:rPr><w:rStyle w:val="apple-converted-space"/><w:color w:val="000000"/></w:rPr><w:t> </w:t></w:r><w:r><w:rPr><w:rStyle w:val="Strong"/><w:color w:val="000000"/></w:rPr><w:t>Content for the new pages will be provided by us</w:t></w:r><w:r><w:rPr><w:rStyle w:val="apple-converted-space"/><w:color w:val="000000"/></w:rPr><w:t> </w:t></w:r><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>— you're not writing content from scratch, but you will need to build appropriate page templates that we can populate.</w:t></w:r></w:p><w:p w14:paraId="46B85CD9" w14:textId="77777777" w:rsidR="007B157D" w:rsidRDefault="007B157D" w:rsidP="007B157D"><w:pPr><w:pStyle w:val="font-claude-response-body"/><w:rPr><w:color w:val="000000"/></w:rPr></w:pPr><w:r><w:rPr><w:rStyle w:val="Strong"/><w:color w:val="000000"/></w:rPr><w:t>4) Existing design files / Figma</w:t></w:r></w:p><w:p w14:paraId="29CEBD1C" w14:textId="77777777" w:rsidR="007B157D" w:rsidRDefault="007B157D" w:rsidP="007B157D"><w:pPr><w:pStyle w:val="font-claude-response-body"/><w:rPr><w:color w:val="000000"/></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>We don't currently have Figma or Sketch design files. What we have instead:</w:t></w:r></w:p><w:p w14:paraId="7B39B190" w14:textId="77777777" w:rsidR="007B157D" w:rsidRDefault="007B157D" w:rsidP="007B157D"><w:pPr><w:pStyle w:val="font-claude-response-body"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr><w:rPr><w:color w:val="000000"/></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>Three reference HTML page designs already built showing the target design language — I'll share these as attachments (</w:t></w:r><w:r><w:rPr><w:rStyle w:val="HTMLCode"/><w:color w:val="000000"/></w:rPr><w:t>traibcert-homepage-elite.html</w:t></w:r><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>,</w:t></w:r><w:r><w:rPr><w:rStyle w:val="apple-converted-space"/><w:color w:val="000000"/></w:rPr><w:t> </w:t></w:r><w:r><w:rPr><w:rStyle w:val="HTMLCode"/><w:color w:val="000000"/></w:rPr><w:t>cyber-essentials.php</w:t></w:r><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>,</w:t></w:r><w:r><w:rPr><w:rStyle w:val="apple-converted-space"/><w:color w:val="000000"/></w:rPr><w:t> </w:t></w:r><w:r><w:rPr><w:rStyle w:val="HTMLCode"/><w:color w:val="000000"/></w:rPr><w:t>iso-42001.html</w:t></w:r><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>). Please treat these as the visual system to work from.</w:t></w:r></w:p><w:p w14:paraId="6F5DCBB5" w14:textId="77777777" w:rsidR="007B157D" w:rsidRDefault="007B157D" w:rsidP="007B157D"><w:pPr><w:pStyle w:val="font-claude-response-body"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr><w:rPr><w:color w:val="000000"/></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>Our</w:t></w:r><w:r><w:rPr><w:rStyle w:val="apple-converted-space"/><w:color w:val="000000"/></w:rPr><w:t> </w:t></w:r><w:r><w:rPr><w:rStyle w:val="Strong"/><w:color w:val="000000"/></w:rPr><w:t>logo</w:t></w:r><w:r><w:rPr><w:rStyle w:val="apple-converted-space"/><w:color w:val="000000"/></w:rPr><w:t> </w:t></w:r><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>in PNG (attached) — please use as-is; we don't want it redesigned.</w:t></w:r></w:p><w:p w14:paraId="7C5CDC41" w14:textId="77777777" w:rsidR="007B157D" w:rsidRDefault="007B157D" w:rsidP="007B157D"><w:pPr><w:pStyle w:val="font-claude-response-body"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr><w:rPr><w:color w:val="000000"/></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>A</w:t></w:r><w:r><w:rPr><w:rStyle w:val="apple-converted-space"/><w:color w:val="000000"/></w:rPr><w:t> </w:t></w:r><w:r><w:rPr><w:rStyle w:val="Strong"/><w:color w:val="000000"/></w:rPr><w:t>header mega-menu structure</w:t></w:r><w:r><w:rPr><w:rStyle w:val="apple-converted-space"/><w:color w:val="000000"/></w:rPr><w:t> </w:t></w:r><w:r><w:rPr><w:color w:val="000000"/></w:rPr><w:t>(attached:</w: